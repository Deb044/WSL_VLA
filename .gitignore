*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Virtual Environments & Conda ---
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# --- Experiment Tracking & Logs ---
wandb/
logs/
*.log
training_*.log

